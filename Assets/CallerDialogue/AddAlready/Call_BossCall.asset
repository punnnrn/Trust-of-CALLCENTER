  conversation:
  - speaker: 1
    text: "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E04\u0E48\u0E30 \u0E2B\u0E31\u0E27\u0E2B\u0E19\u0E49\u0E32"
  - speaker: 0
    text: "\u0E1A\u0E25\u0E39 \u0E19\u0E35\u0E48\u0E04\u0E38\u0E13\u0E0A\u0E48\u0E27\u0E22\u0E17\u0E33\u0E07\u0E32\u0E19\u0E19\u0E35\u0E49\u0E08\u0E30\u0E44\u0E14\u0E49\u0E21\u0E31\u0E49\u0E22
      \u0E07\u0E32\u0E19\u0E14\u0E48\u0E27\u0E19\u0E19\u0E48\u0E30"
  - speaker: 1
    text: "\u0E04\u0E30 \u0E41\u0E15\u0E48\u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E27\u0E31\u0E19\u0E2B\u0E22\u0E38.."
  - speaker: 0
    text: "\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E31\u0E49\u0E19\u0E1C\u0E21\u0E17\u0E23\u0E32\u0E1A\u0E14\u0E35\u0E41\u0E15\u0E48\u0E27\u0E48\u0E32\u0E07\u0E32\u0E19\u0E40\u0E23\u0E48\u0E07\u0E14\u0E48\u0E27\u0E19\u0E19\u0E48\u0E30"
  - speaker: 0
    text: "\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E1C\u0E21\u0E17\u0E23\u0E07\u0E44\u0E1F\u0E25\u0E4C\u0E43\u0E2B\u0E49\u0E17\u0E32\u0E07\u0E2D\u0E35\u0E40\u0E21\u0E25
      \u0E23\u0E35\u0E1A\u0E17\u0E33\u0E0B\u0E30\u0E25\u0E48\u0E30"
  - speaker: 0
    text: "\u0E02\u0E2D\u0E20\u0E32\u0E22\u0E43\u0E19 17.30 \u0E19."
  acceptLabel: "\u0E22\u0E2D\u0E21\u0E23\u0E31\u0E1A"
  declineLabel: "\u0E1B\u0E0F\u0E34\u0E40\u0E2A\u0E18"
  acceptMoney: 0
  acceptCallbackDays: 1
  acceptReply:
  - speaker: 1
    text: "\u0E23\u0E31\u0E1A\u0E17\u0E23\u0E32\u0E1A\u0E04\u0E48\u0E30 \u0E2B\u0E31\u0E27\u0E2B\u0E19\u0E49\u0E32
      \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E08\u0E30\u0E23\u0E35\u0E1A\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E17\u0E31\u0E19\u0E04\u0E48\u0E30"
  - speaker: 0
    text: "\u0E40\u0E23\u0E47\u0E27 \u0E46 \u0E0B\u0E30\u0E25\u0E48\u0E30"
  acceptResult: 
  declineMoney: 0
  declineCallbackDays: 1
  declineReply:
  - speaker: 1
    text: "\u0E04\u0E37\u0E2D \u0E27\u0E48\u0E32\u0E14\u0E34\u0E09\u0E31\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E23\u0E35\u0E1A\u0E44\u0E1B\u0E40\u0E1D\u0E49\u0E32\u0E19\u0E49\u0E2D\u0E07\u0E0A\u0E32\u0E22\u0E17\u0E35\u0E48\u0E42\u0E23\u0E07\u0E1E\u0E22\u0E32\u0E1A\u0E32\u0E25\u0E15\u0E2D\u0E19\u0E40\u0E17\u0E35\u0E48\u0E22\u0E07\u0E19\u0E35\u0E49
      \u0E14\u0E34\u0E09\u0E31\u0E19\u0E01\u0E25\u0E31\u0E27\u0E27\u0E48\u0E32\u0E08\u0E30\u0E44\u0E21\u0E48\u0E17\u0E31\u0E19\u0E19\u0E48\u0E30\u0E04\u0E48\u0E30"
  - speaker: 0
    text: ....
  - speaker: 0
    text: "\u0E07\u0E31\u0E49\u0E19\u0E40\u0E23\u0E2D\u0E30 \u0E07\u0E31\u0E49\u0E19\u0E09\u0E31\u0E19\u0E08\u0E30\u0E25\u0E2D\u0E07\u0E2B\u0E32\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E14\u0E39"
