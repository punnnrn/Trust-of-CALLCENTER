  minDay: 1
  maxDay: 0
  maxCalls: 0
  minMoney: 0
  timeWindows: []
  conversation:
  - speaker: 0
    text: "\u0E2E\u0E31\u0E25\u0E42\u0E2B\u0E25\u0E21\u0E36\u0E07 \u0E40\u0E1B\u0E47\u0E19\u0E44\u0E07\u0E1A\u0E49\u0E32\u0E07\u0E27\u0E30\u0E0A\u0E48\u0E27\u0E07\u0E19\u0E35\u0E49\u0E2A\u0E1A\u0E32\u0E22\u0E14\u0E35\u0E1B\u0E48\u0E30"
  - speaker: 1
    text: "\u0E40\u0E2D\u0E48\u0E2D \u0E43\u0E04\u0E23\u0E2D\u0E48\u0E30 \u0E08\u0E33\u0E40\u0E2A\u0E35\u0E22\u0E07\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E40\u0E25\u0E22"
  - speaker: 0
    text: "\u0E01\u0E31\u0E19 \u0E44\u0E07\u0E15\u0E2D\u0E19 \u0E21.\u0E15\u0E49\u0E19\u0E2D\u0E48\u0E30
      \u0E08\u0E33\u0E44\u0E14\u0E49\u0E1B\u0E48\u0E32\u0E27"
  - speaker: 1
    text: "\u0E15\u0E2D\u0E19 \u0E21.\u0E15\u0E49\u0E19... \u0E40\u0E2D\u0E48\u0E2D\u0E2D
      \u0E2D\u0E4B\u0E2D \u0E08\u0E33\u0E44\u0E14\u0E49\u0E46 \u0E01\u0E31\u0E19\u0E17\u0E35\u0E48\u0E0A\u0E2D\u0E1A\u0E40\u0E15\u0E30\u0E1A\u0E2D\u0E25\u0E1B\u0E48\u0E30"
  - speaker: 0
    text: "\u0E40\u0E15\u0E30\u0E1A\u0E2D\u0E25\u0E2D\u0E30\u0E44\u0E23 \u0E40\u0E25\u0E48\u0E19\u0E1A\u0E32\u0E2A\u0E14\u0E34"
  - speaker: 1
    text: "... \u0E2D\u0E4B\u0E2D\u0E2D\u0E2D \u0E21\u0E35 2 \u0E01\u0E31\u0E19 \u0E2D\u0E48\u0E30\u0E14\u0E34\u0E25\u0E37\u0E21\u0E46
      \u0E42\u0E17\u0E29\u0E17\u0E35\u0E46"
  - speaker: 0
    text: "\u0E21\u0E35 2 \u0E01\u0E31\u0E19\u0E2D\u0E30\u0E44\u0E23 \u0E21\u0E35\u0E01\u0E31\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27"
  - speaker: 1
    text: "\u0E2D\u0E48\u0E2D\u0E2E\u0E48\u0E32\u0E46\u0E46\u0E46"
  - speaker: 1
    text: "\u0E40\u0E2D\u0E2D \u0E41\u0E25\u0E49\u0E27\u0E42\u0E17\u0E23\u0E21\u0E32\u0E21\u0E35\u0E44\u0E23\u0E27\u0E30"
  - speaker: 0
    text: "\u0E07\u0E31\u0E49\u0E19\u0E40\u0E02\u0E49\u0E32\u0E1B\u0E23\u0E30\u0E40\u0E14\u0E47\u0E19\u0E40\u0E25\u0E22\u0E19\u0E30"
  - speaker: 0
    text: "\u0E21\u0E36\u0E07\u0E08\u0E33\u0E44\u0E2D\u0E40\u0E1A\u0E2A \u0E44\u0E14\u0E49\u0E21\u0E31\u0E49\u0E22
      \u0E21\u0E31\u0E19\u0E15\u0E34\u0E14\u0E40\u0E07\u0E34\u0E19\u0E01\u0E39\u0E40\u0E27\u0E49\u0E22"
  - speaker: 1
    text: "\u0E40\u0E2D\u0E2D \u0E41\u0E25\u0E49\u0E27\u0E44\u0E07\u0E27\u0E30"
  - speaker: 0
    text: "\u0E41\u0E25\u0E49\u0E27\u0E15\u0E2D\u0E19\u0E40\u0E19\u0E35\u0E49\u0E22\u0E01\u0E39\u0E44\u0E21\u0E48\u0E21\u0E35\u0E40\u0E07\u0E34\u0E19
      \u0E40\u0E25\u0E22\u0E08\u0E30\u0E21\u0E32\u0E22\u0E37\u0E21\u0E21\u0E36\u0E07\u0E2B\u0E19\u0E48\u0E2D\u0E22"
  acceptLabel: "\u0E43\u0E2B\u0E49\u0E22\u0E37\u0E21"
  declineLabel: "\u0E1B\u0E0F\u0E34\u0E40\u0E2A\u0E18"
  acceptMoney: -1000
  acceptCallbackDays: 1
  acceptReply:
  - speaker: 1
    text: "\u0E40\u0E2D\u0E2D \u0E44\u0E14\u0E49\u0E14\u0E34 \u0E40\u0E17\u0E48\u0E32\u0E44\u0E2B\u0E23\u0E48\u0E27\u0E30"
  - speaker: 0
    text: "\u0E1E\u0E31\u0E19\u0E19\u0E36\u0E07 \u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E43\u0E01\u0E25\u0E49\u0E2A\u0E34\u0E49\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E41\u0E25\u0E49\u0E27
      \u0E40\u0E07\u0E34\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E2D\u0E2D\u0E01\u0E1B\u0E38\u0E4A\u0E1A
      \u0E01\u0E39\u0E42\u0E2D\u0E19\u0E43\u0E2B\u0E49\u0E40\u0E25\u0E22"
  - speaker: 1
    text: "\u0E40\u0E2D\u0E2D\u0E46\u0E46\u0E46"
  acceptResult: 
  declineMoney: 0
  declineCallbackDays: 1
  declineReply:
  - speaker: 1
    text: "\u0E1A\u0E49\u0E32\u0E1B\u0E48\u0E32\u0E27 \u0E21\u0E36\u0E07\u0E01\u0E47\u0E44\u0E1B\u0E17\u0E27\u0E07\u0E21\u0E31\u0E19\u0E14\u0E34
      \u0E08\u0E30\u0E21\u0E32\u0E22\u0E37\u0E21\u0E01\u0E39\u0E17\u0E33\u0E44\u0E21"
  - speaker: 0
    text: "\u0E01\u0E39\u0E44\u0E1B\u0E17\u0E27\u0E07\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27
      \u0E21\u0E31\u0E19\u0E1A\u0E2D\u0E01\u0E21\u0E31\u0E19\u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E21\u0E35"
  - speaker: 1
    text: "\u0E40\u0E2D\u0E49\u0E32\u0E41\u0E25\u0E49\u0E27\u0E17\u0E33\u0E44\u0E21\u0E21\u0E31\u0E19\u0E21\u0E35\u0E1B\u0E31\u0E0D\u0E0D\u0E32\u0E22\u0E37\u0E21
      \u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E1B\u0E31\u0E0D\u0E0D\u0E32\u0E04\u0E37\u0E19"
  - speaker: 0
    text: "\u0E40\u0E2D\u0E32\u0E19\u0E48\u0E32\u0E32 \u0E21\u0E31\u0E19\u0E1A\u0E2D\u0E01\u0E04\u0E37\u0E19\u0E2A\u0E34\u0E49\u0E19\u0E40\u0E14\u0E37\u0E2D\u0E19\u0E19\u0E35\u0E49"
  - speaker: 1
    text: "\u0E44\u0E21\u0E48\u0E40\u0E2D\u0E32\u0E2D\u0E48\u0E30 \u0E08\u0E30\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E01\u0E32\u0E23\u0E31\u0E19\u0E15\u0E35\u0E44\u0E14\u0E49\u0E27\u0E48\u0E32\u0E01\u0E39\u0E08\u0E30\u0E44\u0E14\u0E49\u0E04\u0E37\u0E19"
  - speaker: 0
    text: "... \u0E27\u0E38\u0E49 \u0E02\u0E35\u0E49\u0E07\u0E01\u0E27\u0E48\u0E30!?"
  - speaker: 0
    text: "** \u0E15\u0E31\u0E14\u0E2A\u0E32\u0E22 **"
  declineResult: 
  hangUpMoney: 0
  hangUpCallbackDays: 1
  hangUpReply: []
  hangUpResult: "\u0E04\u0E38\u0E13\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E2A\u0E32\u0E22\u0E19\u0E35\u0E49"
