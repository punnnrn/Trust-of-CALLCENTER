  - speaker: 1
    text: "\u0E43\u0E0A\u0E48\u0E04\u0E48\u0E30 \u0E1A\u0E25\u0E39\u0E09\u0E31\u0E19\u0E40\u0E2D\u0E07\u0E04\u0E48\u0E30"
